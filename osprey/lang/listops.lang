import Osprey.Input
import Osprey.Repeat
import Lang.Prelude
import Lang.Prelude.Instances
import Lang.Prelude.Typeclasses.Sum
import Sum.SumOps
import Lang.Prelude.Typeclasses.Product
import Product.ProductOps
import Lang.Prelude.Typeclasses.Sub
import Sub.SubOps
import Lang.Prelude.Typeclasses.Mod
import Mod.ModOps
import Lang.Prelude.Typeclasses.Eq
import Eq.EqOps
import Lang.Prelude.Typeclasses.Ord
import Ord.OrdOps
import Lang.Cli.Text
import Lang.Text.MachineFormat
import Lang.Data.List

fn range : Uint64 -> Uint64 -> List(Uint64)
range first last =
  if first > last then nil
  else cons first (if first == last then nil else range (first + 1u64) last)

fn random_step : Uint64 -> Uint64
random_step value = (value * 16807u64) % 2147483647u64

fn hash_at : Uint64 -> Uint64 -> Uint64
hash_at seed index = random_step (random_step (seed + index))

fn sample : Uint64 -> Uint64
sample seed =
  let values = list_map (\index -> hash_at seed index % 1000u64) (range 0u64 3999u64) in
  let total = list_fold_left (\sum value -> sum + value) 0u64 values in
  let below = list_filter (\value -> value < 500u64) values in
  total + list_fold_left (\count _ -> count + 1u64) 0u64 below

fn benchmark : Uint64 -> Uint64
benchmark seed =
  list_fold_left (\total t -> (total + sample (seed + t * 131u64)) % 1000000007u64) 0u64 (range 0u64 7u64)

proc main : Unit
main =
  let reps = osprey_repetitions () in
  let seed = osprey_read_seed () in
  let _ = cli_write_line cli_stdout
    (integer_render integer_u64 radix_decimal (osprey_repeat reps seed (\s -> the Uint64 in benchmark s))) in ()
