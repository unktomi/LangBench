fn range : Uint64 -> Uint64 -> List(Uint64)
range first last =
  if first > last then nil
  else cons first (if first == last then nil else range (first + 1u64) last)

fn collatz : Uint64 -> Computation(Uint64)
computation_step (collatz n) =
  if n == 1u64 then computation_finished 0u64
  else computation_pending
    (computation_map (\steps -> 1u64 + steps)
      (collatz (if n % 2u64 == 0u64 then n / 2u64 else 3u64 * n + 1u64)))

fn benchmark : Uint64 -> Uint64
benchmark limit =
  list_fold_left (\total n -> total + computation_run (collatz n)) 0u64 (range 1u64 limit)

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark parameter_1)) in ()
