import Osprey.Arguments
import Lang.Prelude
import Lang.Prelude.Instances
import Lang.Prelude.Typeclasses.Sum
import Sum.SumOps
import Lang.Prelude.Typeclasses.Sub
import Sub.SubOps
import Lang.Prelude.Typeclasses.Eq
import Eq.EqOps
import Lang.Prelude.Typeclasses.Ord
import Ord.OrdOps
import Lang.Cli.Text
import Lang.Text.MachineFormat

fn coin : Uint64 -> Int64
coin kind = match kind with
  1u64 -> 1i64
  2u64 -> 5i64
  3u64 -> 10i64
  4u64 -> 25i64
  _ -> 50i64
end

fn ways : Int64 -> Uint64 -> Uint64
ways amount kind =
  if amount == 0i64 then 1u64
  else if amount < 0i64 then 0u64
  else if kind == 0u64 then 0u64
  else ways (amount - coin kind) kind + ways amount (kind - 1u64)

fn benchmark : Int64 -> Uint64 -> Uint64
benchmark amount kind = ways amount kind

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let parameter_2 = osprey_argument 2i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark (Int64.from_uint64 parameter_1) parameter_2)) in ()
