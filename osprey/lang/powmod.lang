import Lang.Prelude.Typeclasses.Product
import ProductOps
import Lang.Prelude.Typeclasses.Sub
import SubOps
import Lang.Prelude.Typeclasses.Mod
import ModOps
import Lang.Prelude.Typeclasses.Eq
import EqOps
import Lang.Prelude.Typeclasses.Ord
import OrdOps
import Lang.Cli.Text
import Lang.Text.MachineFormat
import Lang.Data.List

fn range : Uint64 -> Uint64 -> List(Uint64)
range first last =
  if first > last then nil
  else cons first (if first == last then nil else range (first + 1u64) last)

fn power : Uint64 -> Uint64 -> Uint64 -> Uint64
power base exponent product = if exponent == 0u64 then product
  else power base (exponent - 1u64) ((product * base) % 1000000007u64)

fn benchmark : Uint64 -> Uint64
benchmark limit =
  list_fold_left (\total n -> (total + power n 20u64 1u64) % 1000000007u64) 0u64 (range 1u64 limit)

proc main : Unit
main = the Unit in
  let parameter_1 = osprey_argument 1i64 in
  let _ = cli_write_line cli_stdout
  (integer_render integer_u64 radix_decimal (benchmark parameter_1)) in ()
