import Ord.OrdOps
import Lang.Cli.Text
import Lang.Text.MachineFormat
import Lang.Data.List

fn range : Uint64 -> Uint64 -> List(Uint64)
range first last =
  if first > last then nil
  else cons first (if first == last then nil else range (first + 1u64) last)

fn random_step : Uint64 -> Uint64
random_step value = (value * 16807u64) % 2147483647u64

fn hash_at : Uint64 -> Uint64 -> Uint64
hash_at seed index = random_step (random_step (seed + index))

data Expr where
  literal : Uint64 -> Expr
  addition : Expr -> Expr -> Expr
  multiplication : Expr -> Expr -> Expr
end

fn build : Uint64 -> Uint64 -> Uint64 -> Expr
build seed index depth =
  if depth == 0u64 then literal (hash_at seed index % 1000u64)
  else let left = build seed (index * 2u64 + 1u64) (depth - 1u64) in
    let right = build seed (index * 2u64 + 2u64) (depth - 1u64) in
    if hash_at seed index % 2u64 == 0u64 then addition left right
    else multiplication left right

fn evaluate : Expr -> Uint64
evaluate (literal value) = value
evaluate (addition left right) = (evaluate left + evaluate right) % 1000000007u64
evaluate (multiplication left right) = (evaluate left * evaluate right) % 1000000007u64

fn benchmark : Uint64 -> Uint64
benchmark seed =
  list_fold_left (\total t -> (total + evaluate (build (seed + t * 7u64) 1u64 14u64)) % 1000000007u64) 0u64 (range 0u64 9u64)

proc main : Unit
main =
  let reps = osprey_repetitions () in
  let seed = osprey_read_seed () in
  let _ = cli_write_line cli_stdout
    (integer_render integer_u64 radix_decimal (osprey_repeat reps seed (\s -> the Uint64 in benchmark s))) in ()
