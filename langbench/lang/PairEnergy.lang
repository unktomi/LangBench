import Lang.Prelude
import Lang.Prelude.Instances
import Lang.Prelude.Typeclasses.Sub
import Sub.SubOps
import Lang.Prelude.Typeclasses.Sum
import Sum.SumOps
import Lang.Prelude.Typeclasses.Product
import Product.ProductOps
import Lang.Data.List.Core

fn row_energy : Uint64 -> List(Uint64) -> Uint64
row_energy x nil = 0u64
row_energy x (cons y ys) =
  let difference = (x - y) in
  ((difference * difference) + row_energy x ys)

fn all_energy : List(Uint64) -> List(Uint64) -> Uint64
all_energy nil values = 0u64
all_energy (cons x xs) values = (row_energy x values + all_energy xs values)

fn benchmark : List(Uint64) -> Uint64
benchmark values = the Uint64 in all_energy values values
