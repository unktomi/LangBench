import Lang.Prelude
import Lang.Cli.Process
import RuntimeTreeArguments
import RuntimeTreeDirect
import SigfpeCli

proc usage : Unit
usage = sigfpe_usage "usage: runtime-tree (forward|flipped) PREFIX_TOKENS..."

proc main : Unit
main =
  let count = cli_argument_count_native () in
  if Int64.lt count 3i64 then usage else
  match cli_argument_nth (cli_arguments !cli_process) 1i64 with
    nothing -> usage
    just mode ->
      if Bool.or (String.eq mode "forward") (String.eq mode "flipped") then
        match runtime_tree_arguments count with
          nothing -> usage
          just expression ->
            if String.eq mode "forward" then sigfpe_print (runtime_tree_forward expression)
            else sigfpe_print (runtime_tree_flipped expression)
        end
      else usage
  end
