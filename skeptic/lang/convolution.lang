import Lang.Prelude
import Lang.Data.List.Core
import Lang.Cli.Process
import Lang.Cli.Text
import Lang.Text.MachineParse
import BenchmarkInput

-- P(x) = p + x*P'(x). Each row contributes p*Q(x) and shifts the
-- following rows by one coefficient. A zero coefficient still occupies a slot.
fn row : Uint64 -> List(Uint64) -> List(Uint64) -> List(Uint64)
row _ nil previous = previous
row a (cons b bs) nil = cons (Uint64.mul a b) (row a bs nil)
row a (cons b bs) (cons c cs) = cons (Uint64.add c (Uint64.mul a b)) (row a bs cs)

fn coefficients : List(Uint64) -> List(Uint64) -> List(Uint64)
coefficients nil _ = nil
coefficients (cons a rest) right = match right with
  nil -> nil
  cons _ _ -> match rest with
    nil -> row a right nil
    cons _ _ -> row a right (cons 0u64 (coefficients rest right))
  end
end

fn benchmark : List(Uint64) -> List(Uint64) -> List(Uint64)
benchmark left right = the List(Uint64) in coefficients left right

fn digest : Uint64 -> List(Uint64) -> Uint64
digest state nil = state
digest state (cons c cs) = digest (bench_sample (Uint64.bit_xor state c)) cs

proc print_coefficients : Bool -> List(Uint64) -> Unit
print_coefficients _ nil = let _ = cli_write_line cli_stdout "" in ()
print_coefficients first (cons c cs) =
  let text = integer_render integer_u64 radix_decimal c in
  let _ = cli_write_text cli_stdout (if first then text else String.concat " " text) in
  print_coefficients false cs

proc main : Unit
main =
  let show_all = match cli_argument_nth (cli_arguments !cli_process) 1i64 with
    nothing -> false
    just text -> String.eq text "--coefficients"
  end in
  let index = if show_all then 2i64 else 1i64 in
  let usage = "usage: convolution [--coefficients] <left-count> [values...] | <left-count> --generate [total-count [seed]]" in
  match bench_argument index with
    nothing -> bench_usage usage
    just split -> match bench_input (Int64.add index 1i64) 2048u64 42u64 with
      nothing -> bench_usage usage
      just values -> let output = benchmark (bench_take split values) (bench_drop split values) in
        if show_all then print_coefficients true output else bench_print (digest 14695981039346656037u64 output)
    end
  end
